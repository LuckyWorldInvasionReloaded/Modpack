shaderpacks/
mods/
build/
.gradle/
# *.zip also covers overrides/addons/lucky/: the community addons are shipped in the CurseForge and
# Modrinth builds only, which is what their licences allow. See ADDON_SOURCES.txt.
*.zip
*.mrpack
*.log

# Player-preference files: not shipped, so the launcher does not overwrite them on every update.
# options.txt = vanilla settings.
# config/luckystats_hud.json = personal HUD layout. Only ship it (git add -f) when a structural HUD
# change would otherwise break existing layouts -- see the release checklist in the guide. It is
# force-added right now because the mod's stats default to disabled, so a fresh install without it
# gets an empty HUD.
# Pack BALANCE configs (drops/rarity/caps, oculus shaders-off) stay tracked.
overrides/options.txt
overrides/config/luckystats_hud.json

# Dev/test-only KubeJS scripts: never ship (header says "NEVER SHIP IN A RELEASE").
overrides/kubejs/server_scripts/*TESTING*.js
